+} from "@t3tools/client-runtime/state/runtime";
+import {
+  threadRuntimeIsActive,
+  type EnvironmentThreadShell,
+} from "@t3tools/client-runtime/state/shell";
+import {
+  ProviderDriverKind,
+  type ModelSelection,
+  type OrchestrationV2ProjectedTurnItem,
+  type ThreadId,
+} from "@t3tools/contracts";
+import { truncate } from "@t3tools/shared/String";
+import { useRouter } from "@tanstack/react-router";
+import {
+  ArrowUpIcon,
+  BrainIcon,
+  CheckIcon,
+  ChevronDownIcon,
+  CopyIcon,
+  HistoryIcon,
+  Maximize2Icon,
+  MinusIcon,
+  SearchIcon,
+  SparklesIcon,
+  SquarePenIcon,
+  XIcon,
+} from "lucide-react";
+import {
+  type KeyboardEvent as ReactKeyboardEvent,
+  memo,
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useMemo,
+  useRef,
+  useState,
+} from "react";
+
+import { cn, isMacPlatform, newMessageId, newThreadId } from "~/lib/utils";
+import { useThreadShell, useThreadShells, useThreadVisibleTurnItems } from "~/state/entities";
+import { primaryServerProvidersAtom } from "~/state/server";
+import { threadEnvironment } from "~/state/threads";
+import { useOrchestrationCommand } from "~/state/use-orchestration-command";
+import { buildThreadRouteParams } from "~/threadRoutes";
+import ChatMarkdown from "../ChatMarkdown";
+import { Menu, MenuPopup, MenuRadioGroup, MenuRadioItem, MenuTrigger } from "../ui/menu";
+import { Spinner } from "../ui/spinner";
+import { stackedThreadToast, toastManager } from "../ui/toast";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+import {
+  CHAT_PANEL_TONES,
+  stripTone,
+  useChatPanelStore,
+  withTone,
+  type ChatPanelTone,
+} from "./chatPanelStore";
+import { useChatPanelProject } from "./useChatPanelProject";
+
+const CLAUDE_DRIVER = ProviderDriverKind.make("claudeAgent");
+
+/**
+ * Full access so connectors (Teams, Smartsheet, …) and web fetches run without
+ * prompts. ~/Chat/.claude/settings.json deny rules still apply in this mode and
+ * keep CLAUDE.md, voice*.md and .claude/ read-only.
+ */
+const CHAT_RUNTIME_MODE = "full-access" as const;
+
+/** ⌘⇧I on macOS (⌘I is italic in the composer, ⌥⌘I is devtools). */
+export const CHAT_PANEL_SHORTCUT_LABEL =
+  typeof navigator !== "undefined" && isMacPlatform(navigator.platform) ? "⇧⌘I" : "Ctrl+Shift+I";
+
+function isChatPanelShortcut(event: KeyboardEvent): boolean {
+  return (
+    (event.metaKey || event.ctrlKey) &&
+    event.shiftKey &&
+    !event.altKey &&
+    event.key.toLowerCase() === "i"
+  );
+}
+
+/** One-click rewrites under each reply; each just sends a follow-up. */
+const REWRITES = [
+  { label: "Shorter", prompt: "Make that shorter. Keep my voice." },
+  { label: "Warmer", prompt: "Make that warmer and friendlier. Keep it concise." },
+  { label: "More formal", prompt: "Make that more formal and polished." },
+] as const;
+
+const STARTERS = [
+  { label: "Draft a reply", prompt: "Help me reply to this:\n\n" },
+  { label: "Polish my writing", prompt: "Polish this so it reads well, keep my voice:\n\n" },
+  { label: "Remember something", prompt: "Remember this about me: " },
+] as const;
+
+function useClaudeModels() {
+  const providers = useAtomValue(primaryServerProvidersAtom);
+  return useMemo(() => {
+    const claude = providers.find(
+      (provider) => provider.driver === CLAUDE_DRIVER && provider.enabled,
+    );
+    const models = (claude?.models ?? []).filter((model) => !model.isLegacy);
+    // Sonnet writes well and spends the weekly limit slowly, so it's the default.
+    const fallback =
+      models.find((model) => /sonnet/i.test(model.slug)) ??
+      models.find((model) => model.isDefault) ??
+      models[0];
+    return { instanceId: claude?.instanceId ?? null, models, fallback: fallback?.slug ?? null };
+  }, [providers]);
+}
+
+function modelLabel(name: string): string {
+  return name.replace(/^Claude\s+/i, "");
+}
+
+function relativeDay(iso: string): string {
+  const then = new Date(iso);
+  const now = new Date();
+  const days = Math.floor(
+    (new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() -
+      new Date(then.getFullYear(), then.getMonth(), then.getDate()).getTime()) /
+      86_400_000,
+  );
+  if (days <= 0) return "Today";
+  if (days === 1) return "Yesterday";
+  if (days < 7) return "This week";
+  if (days < 30) return "This month";
+  return "Older";
+}
+
+function timeLabel(iso: string): string {
+  const date = new Date(iso);
+  return relativeDay(iso) === "Today"
+    ? date.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" })
+    : date.toLocaleDateString(undefined, { month: "short", day: "numeric" });
+}
+
+function IconButton({
+  label,
+  onClick,
+  active,
+  children,
+}: {
+  label: string;
+  onClick: () => void;
+  active?: boolean;
+  children: React.ReactNode;
+}) {
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <button
+            type="button"
+            aria-label={label}
+            onClick={onClick}
+            className={cn(
+              "flex size-7 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground [&_svg]:size-3.5",
+              active && "bg-accent text-foreground",
+            )}
+          />
+        }
+      >
+        {children}
+      </TooltipTrigger>
+      <TooltipPopup side="bottom">{label}</TooltipPopup>
+    </Tooltip>
+  );
+}
+
+/** Mounted once at the app root: the floating panel, its minimized pill, and the shortcut. */
+export function ChatPanel() {
+  const mode = useChatPanelStore((state) => state.mode);
+  const toggle = useChatPanelStore((state) => state.toggle);
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (!isChatPanelShortcut(event)) return;
+      event.preventDefault();
+      event.stopPropagation();
+      toggle();
+    };
+    window.addEventListener("keydown", onKeyDown, { capture: true });
+    return () => window.removeEventListener("keydown", onKeyDown, { capture: true });
+  }, [toggle]);
+
+  if (mode === "open") return <ChatPanelWindow />;
+  if (mode === "minimized") return <ChatPanelPill />;
+  return null;
+}
+
+function useActiveThread() {
+  const { environmentId } = useChatPanelProject();
+  const activeThreadId = useChatPanelStore((state) => state.activeThreadId);
+  const ref = useMemo(
+    () =>
+      environmentId !== null && activeThreadId !== null
+        ? scopeThreadRef(environmentId, activeThreadId)
+        : null,
+    [activeThreadId, environmentId],
+  );
+  const shell = useThreadShell(ref);
+  return { ref, shell };
+}
+
+function ChatPanelPill() {
+  const setMode = useChatPanelStore((state) => state.setMode);
+  const { shell } = useActiveThread();
+  const running = threadRuntimeIsActive(shell?.runtime);
+  return (
+    <div className="fixed right-4 bottom-4 z-49 flex items-center gap-1 rounded-full border border-border/70 bg-background py-1 pr-1 pl-3 text-popover-foreground text-xs shadow-lg">
+      <button
+        type="button"
+        onClick={() => setMode("open")}
+        className="flex max-w-56 cursor-pointer items-center gap-2"
+      >
+        {running ? (
+          <Spinner className="size-3" />
+        ) : (
+          <SparklesIcon className="size-3.5 text-primary" />
+        )}
+        <span className="truncate">{shell?.title ?? "Chat"}</span>
+        <span className="text-muted-foreground">{running ? "writing…" : null}</span>
+      </button>
+      <span className="ml-1 rounded bg-muted px-1 text-2xs text-muted-foreground">
+        {CHAT_PANEL_SHORTCUT_LABEL}
+      </span>
+      <IconButton label="Close" onClick={() => setMode("closed")}>
+        <XIcon />
+      </IconButton>
+    </div>
+  );
+}
+
+function ChatPanelWindow() {
+  const view = useChatPanelStore((state) => state.view);
+  const setView = useChatPanelStore((state) => state.setView);
+  const setMode = useChatPanelStore((state) => state.setMode);
+  const selectThread = useChatPanelStore((state) => state.selectThread);
+  const router = useRouter();
+  const { ref, shell } = useActiveThread();
+  const panelRef = useRef<HTMLDivElement>(null);
+  const composerRef = useRef<HTMLTextAreaElement>(null);
+
+  useLayoutEffect(() => {
+    panelRef.current?.animate(
+      [
+        { opacity: 0, transform: "translateY(8px) scale(0.98)" },
+        { opacity: 1, transform: "none" },
+      ],
+      { duration: 160, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" },
+    );
+    composerRef.current?.focus();
+  }, []);
+
+  const onKeyDown = (event: ReactKeyboardEvent) => {
+    if (event.key !== "Escape" || event.defaultPrevented) return;
+    event.preventDefault();
+    if (view === "history") setView("chat");
+    else setMode("minimized");
+  };
+
+  const startNewChat = () => {
+    selectThread(null);
+    requestAnimationFrame(() => composerRef.current?.focus());
+  };
+
+  return (
+    <div
+      ref={panelRef}
+      role="dialog"
+      aria-label="Chat"
+      onKeyDown={onKeyDown}
+      className="fixed right-4 bottom-4 z-49 flex h-[min(680px,calc(100dvh-5rem))] w-[min(420px,calc(100vw-2rem))] flex-col overflow-hidden rounded-2xl border border-border bg-background text-foreground shadow-2xl shadow-black/25 dark:shadow-black/60"
+    >
+      <header className="flex h-11 shrink-0 items-center gap-0.5 border-b border-border/60 px-1.5">
+        <IconButton
+          label="All chats"
+          active={view === "history"}
+          onClick={() => setView(view === "history" ? "chat" : "history")}
+        >
+          <HistoryIcon />
+        </IconButton>
+        <div className="min-w-0 flex-1 truncate px-1.5 font-medium text-sm">
+          {view === "history" ? "All chats" : (shell?.title ?? "New chat")}
+        </div>
+        <IconButton label="New chat" onClick={startNewChat}>
+          <SquarePenIcon />
+        </IconButton>
+        {ref !== null && shell !== null ? (
+          <IconButton
+            label="Open as thread"
+            onClick={() => {
+              setMode("minimized");
+              void router.navigate({
+                to: "/$environmentId/$threadId",
+                params: buildThreadRouteParams(ref),
+              });
+            }}
+          >
+            <Maximize2Icon />
+          </IconButton>
+        ) : null}
+        <IconButton label="Minimize (Esc)" onClick={() => setMode("minimized")}>
+          <MinusIcon />
+        </IconButton>
+        <IconButton
+          label={`Close (${CHAT_PANEL_SHORTCUT_LABEL})`}
+          onClick={() => setMode("closed")}
+        >
+          <XIcon />
+        </IconButton>
+      </header>
+      {view === "history" ? (
+        <ChatPanelHistory />
+      ) : (
+        <ChatPanelConversation composerRef={composerRef} />
+      )}
+    </div>
+  );
+}
+
+function ChatPanelHistory() {
+  const { project, environmentId } = useChatPanelProject();
+  const activeThreadId = useChatPanelStore((state) => state.activeThreadId);
+  const selectThread = useChatPanelStore((state) => state.selectThread);
+  const shells = useThreadShells();
+  const [query, setQuery] = useState("");
+
+  const groups = useMemo(() => {
+    const needle = query.trim().toLowerCase();
+    const threads = shells
+      .filter(
+        (thread) =>
+          project !== null &&
+          thread.environmentId === environmentId &&
+          thread.projectId === project.id &&
+          thread.archivedAt === null &&
+          (needle.length === 0 || thread.title.toLowerCase().includes(needle)),
+      )
+      .toSorted((a, b) => b.updatedAt.localeCompare(a.updatedAt));
+    const grouped = new Map<string, EnvironmentThreadShell[]>();
+    for (const thread of threads) {
+      const label = relativeDay(thread.updatedAt);
+      grouped.set(label, [...(grouped.get(label) ?? []), thread]);
+    }
+    return [...grouped];
+  }, [environmentId, project, query, shells]);
+
+  return (
+    <div className="flex min-h-0 flex-1 flex-col">
+      <div className="p-2">
+        <label className="flex items-center gap-2 rounded-lg border border-border/70 bg-background px-2.5 py-1.5 text-sm focus-within:border-ring">
+          <SearchIcon className="size-3.5 text-muted-foreground" />
+          <input
+            autoFocus
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+            placeholder="Search chats…"
+            className="min-w-0 flex-1 bg-transparent outline-none placeholder:text-muted-foreground"
+          />
+        </label>
+      </div>
+      <div className="min-h-0 flex-1 overflow-y-auto px-2 pb-2">
+        {groups.length === 0 ? (
+          <p className="px-2 py-8 text-center text-muted-foreground text-sm">
+            {query ? "No chats match." : "No chats yet."}
+          </p>
+        ) : (
+          groups.map(([label, threads]) => (
+            <section key={label} className="mb-1">
+              <h3 className="px-2 pt-2 pb-1 font-medium text-2xs text-muted-foreground uppercase tracking-wide">
+                {label}
+              </h3>
+              {threads.map((thread) => (
+                <button
+                  key={thread.id}
+                  type="button"
+                  onClick={() => selectThread(thread.id)}
+                  className={cn(
+                    "flex w-full cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 text-left text-sm transition-colors hover:bg-accent",
+                    thread.id === activeThreadId && "bg-accent",
+                  )}
+                >
+                  <span className="min-w-0 flex-1 truncate">{thread.title}</span>
+                  {threadRuntimeIsActive(thread.runtime) ? (
+                    <Spinner className="size-3" />
+                  ) : (
+                    <span className="shrink-0 text-2xs text-muted-foreground tabular-nums">
+                      {timeLabel(thread.updatedAt)}
+                    </span>
+                  )}
+                </button>
+              ))}
+            </section>
+          ))
+        )}
+      </div>
+    </div>
+  );
+}
+
+type PanelMessage =
+  | { readonly id: string; readonly role: "user"; readonly text: string }
+  | {
+      readonly id: string;
+      readonly role: "assistant";
+      readonly text: string;
+      readonly streaming: boolean;
+    };
+
+function ChatPanelConversation({
+  composerRef,
+}: {
+  composerRef: React.RefObject<HTMLTextAreaElement | null>;
+}) {
+  const { ensureProject, environmentId, root } = useChatPanelProject();
+  const { ref, shell } = useActiveThread();
+  const items = useThreadVisibleTurnItems(ref);
+  const selectThread = useChatPanelStore((state) => state.selectThread);
+  const storedModel = useChatPanelStore((state) => state.model);
+  const setModel = useChatPanelStore((state) => state.setModel);
+  const tone = useChatPanelStore((state) => state.tone);
+  const setTone = useChatPanelStore((state) => state.setTone);
+  const { instanceId, models, fallback } = useClaudeModels();
+  const model = models.some((entry) => entry.slug === storedModel) ? storedModel : fallback;
+  const setMode = useChatPanelStore((state) => state.setMode);
+  const router = useRouter();
+  const startThreadTurn = useOrchestrationCommand(threadEnvironment.startTurn, {
+    reportFailure: false,
+  });
+  const interruptTurn = useOrchestrationCommand(threadEnvironment.interruptTurn, {
+    reportFailure: false,
+  });
+  const [draft, setDraft] = useState("");
+  const [sending, setSending] = useState(false);
+  const running = threadRuntimeIsActive(shell?.runtime);
+  const scrollRef = useRef<HTMLDivElement>(null);
+
+  const messages = useMemo(
+    () =>
+      items.flatMap((entry: OrchestrationV2ProjectedTurnItem): PanelMessage[] => {
+        const item = entry.item;
+        if (item.type === "user_message") {
+          return [{ id: item.messageId, role: "user", text: stripTone(item.text).text }];
+        }
+        if (item.type === "assistant_message" && item.text.trim().length > 0) {
+          return [
+            {
+              id: item.messageId,
+              role: "assistant",
+              text: item.text,
+              streaming: item.streaming,
+            },
+          ];
+        }
+        return [];
+      }),
+    [items],
+  );
+
+  // Follow new output only while the reader is already at the bottom.
+  const pinnedToBottom = useRef(true);
+  useLayoutEffect(() => {
+    const el = scrollRef.current;
+    if (el && pinnedToBottom.current) el.scrollTop = el.scrollHeight;
+  }, [messages]);
+
+  const send = useCallback(
+    async (text: string) => {
+      const trimmed = text.trim();
+      if (!trimmed || sending || environmentId === null) return;
+      if (instanceId === null || model === null) {
+        toastManager.add(
+          stackedThreadToast({
+            type: "error",
+            title: "Claude isn't available",
+            description: "Enable the Claude provider in Settings → Providers.",
+          }),
+        );
+        return;
+      }
+      setSending(true);
+      try {
+        const modelSelection: ModelSelection = { instanceId, model };
+        const message = {
+          messageId: newMessageId(),
+          role: "user" as const,
+          text: withTone(trimmed, tone),
+          attachments: [],
+        };
+        const createdAt = new Date().toISOString();
+        let threadId: ThreadId;
+        let result;
+        if (ref !== null && shell !== null) {
+          threadId = ref.threadId;
+          result = await startThreadTurn({
+            environmentId,
+            input: {
+              threadId,
+              message,
+              modelSelection,
+              runtimeMode: CHAT_RUNTIME_MODE,
+              interactionMode: "default",
+              createdAt,
+            },
+          });
+        } else {
+          const project = await ensureProject();
+          threadId = newThreadId();
+          const title = truncate(trimmed);
+          result = await startThreadTurn({
+            environmentId,
+            input: {
+              threadId,
+              message,
+              modelSelection,
+              titleSeed: title,
+              runtimeMode: CHAT_RUNTIME_MODE,
+              interactionMode: "default",
+              bootstrap: {
+                createThread: {
+                  projectId: project.id,
+                  title,
+                  modelSelection,
+                  runtimeMode: CHAT_RUNTIME_MODE,
+                  interactionMode: "default",
+                  branch: null,
+                  worktreePath: null,
+                  createdAt,
+                },
+              },
+              createdAt,
+            },
+          });
+        }
+        if (result._tag === "Failure") {
+          if (isAtomCommandInterrupted(result)) return;
+          throw squashAtomCommandFailure(result);
+        }
+        selectThread(threadId);
+        setDraft("");
+        pinnedToBottom.current = true;
+      } catch (error) {
+        toastManager.add(
+          stackedThreadToast({
+            type: "error",
+            title: "Could not send",
+            description: error instanceof Error ? error.message : "An error occurred.",
+          }),
+        );
+      } finally {
+        setSending(false);
+      }
+    },
+    [
+      ensureProject,
+      environmentId,
+      instanceId,
+      model,
+      ref,
+      selectThread,
+      sending,
+      shell,
+      startThreadTurn,
+      tone,
+    ],
+  );
+
+  const stop = () => {
+    if (environmentId === null || ref === null) return;
+    void interruptTurn({ environmentId, input: { threadId: ref.threadId } });
+  };
+
+  const lastAssistantId = messages.findLast((message) => message.role === "assistant")?.id;
+  const waitingForFirstToken = running && messages.at(-1)?.role === "user";
+
+  return (
+    <>
+      <div
+        ref={scrollRef}
+        onScroll={(event) => {
+          const el = event.currentTarget;
+          pinnedToBottom.current = el.scrollHeight - el.scrollTop - el.clientHeight < 48;
+        }}
+        className="min-h-0 flex-1 overflow-y-auto px-4 py-3"
+      >
+        {messages.length === 0 && !running ? (
+          <div className="flex h-full flex-col items-center justify-center gap-4 text-center">
+            <div className="flex size-10 items-center justify-center rounded-2xl bg-primary/10 text-primary">
+              <SparklesIcon className="size-5" />
+            </div>
+            <div>
+              <p className="font-medium text-sm">What are we writing?</p>
+              <p className="mt-1 text-muted-foreground text-xs">
+                Writes in your voice and remembers you via{" "}
+                <code className="rounded bg-muted px-1">~/Chat</code>
+              </p>
+            </div>
+            <div className="flex flex-wrap justify-center gap-1.5">
+              {STARTERS.map((starter) => (
+                <button
+                  key={starter.label}
+                  type="button"
+                  onClick={() => {
+                    setDraft(starter.prompt);
+                    composerRef.current?.focus();
+                  }}
+                  className="cursor-pointer rounded-full border border-border/70 px-2.5 py-1 text-muted-foreground text-xs transition-colors hover:bg-accent hover:text-foreground"
+                >
+                  {starter.label}
+                </button>
+              ))}
+            </div>
+          </div>
+        ) : (
+          <div className="flex flex-col gap-4">
+            {messages.map((message) =>
+              message.role === "user" ? (
+                <div
+                  key={message.id}
+                  className="ml-8 self-end whitespace-pre-wrap break-words rounded-2xl rounded-br-md bg-secondary px-3 py-2 text-secondary-foreground text-sm"
+                >
+                  {message.text}
+                </div>
+              ) : (
+                <AssistantMessage
+                  key={message.id}
+                  text={message.text}
+                  streaming={message.streaming}
+                  cwd={root ?? undefined}
+                  showRewrites={message.id === lastAssistantId && !running}
+                  onRewrite={(prompt) => void send(prompt)}
+                />
+              ),
+            )}
+            {waitingForFirstToken ? (
+              <div className="flex items-center gap-2 text-muted-foreground text-xs">
+                <Spinner className="size-3" /> Thinking…
+              </div>
+            ) : null}
+          </div>
+        )}
+      </div>
+
+      {ref !== null && (shell?.hasPendingApprovals || shell?.hasPendingUserInput) ? (
+        <div className="mx-2 mb-2 flex items-center gap-2 rounded-lg border border-warning/40 bg-warning/10 px-3 py-2 text-xs">
+          <span className="min-w-0 flex-1">Claude is waiting for your approval.</span>
+          <button
+            type="button"
+            onClick={() => {
+              setMode("minimized");
+              void router.navigate({
+                to: "/$environmentId/$threadId",
+                params: buildThreadRouteParams(ref),
+              });
+            }}
+            className="shrink-0 cursor-pointer rounded-md bg-foreground/90 px-2 py-1 text-background hover:bg-foreground"
+          >
+            Review
+          </button>
+        </div>
+      ) : null}
+      <div className="shrink-0 p-2 pt-0">
+        <div className="rounded-xl border border-border/70 bg-muted/40 transition-colors focus-within:border-ring">
+          <textarea
+            ref={composerRef}
+            value={draft}
+            rows={1}
+            placeholder="Ask, or paste a message to reply to…"
+            onChange={(event) => {
+              setDraft(event.target.value);
+              const el = event.target;
+              el.style.height = "auto";
+              el.style.height = `${Math.min(el.scrollHeight, 180)}px`;
+            }}
+            onKeyDown={(event) => {
+              if (event.key === "Enter" && !event.shiftKey && !event.nativeEvent.isComposing) {
+                event.preventDefault();
+                void send(draft);
+              }
+            }}
+            className="block max-h-45 min-h-11 w-full resize-none bg-transparent px-3 pt-2.5 pb-1 text-sm outline-none placeholder:text-muted-foreground"
+          />
+          <div className="flex items-center gap-1 px-1.5 pb-1.5">
+            <PickerMenu
+              icon={null}
+              value={model ?? ""}
+              label={modelLabel(models.find((entry) => entry.slug === model)?.name ?? "Claude")}
+              options={models.map((entry) => ({
+                value: entry.slug,
+                label: modelLabel(entry.name),
+              }))}
+              onChange={setModel}
+            />
+            <PickerMenu
+              icon={<BrainIcon className="size-3" />}
+              value={tone}
+              label={`Tone: ${tone}`}
+              options={CHAT_PANEL_TONES.map((value) => ({ value, label: value }))}
+              onChange={(value) => setTone(value as ChatPanelTone)}
+            />
+            <div className="flex-1" />
+            {running ? (
+              <button
+                type="button"
+                aria-label="Stop"
+                onClick={stop}
+                className="flex size-7 cursor-pointer items-center justify-center rounded-full bg-foreground/90 text-background transition-colors hover:bg-foreground"
+              >
+                <span className="size-2.5 rounded-xs bg-current" />
+              </button>
+            ) : (
+              <button
+                type="button"
+                aria-label="Send"
+                disabled={draft.trim().length === 0 || sending}
+                onClick={() => void send(draft)}
+                className="flex size-7 cursor-pointer items-center justify-center rounded-full bg-primary text-primary-foreground transition-opacity hover:bg-primary/90 disabled:cursor-default disabled:opacity-40"
+              >
+                {sending ? <Spinner className="size-3.5" /> : <ArrowUpIcon className="size-4" />}
+              </button>
+            )}
+          </div>
+        </div>
+      </div>
+    </>
+  );
+}
+
+function PickerMenu({
+  icon,
+  value,
+  label,
+  options,
+  onChange,
+}: {
+  icon: React.ReactNode;
+  value: string;
+  label: string;
+  options: ReadonlyArray<{ value: string; label: string }>;
+  onChange: (value: string) => void;
+}) {
+  return (
+    <Menu>
+      <MenuTrigger
+        render={
+          <button
+            type="button"
+            className="flex h-6 cursor-pointer items-center gap-1 rounded-md px-1.5 text-muted-foreground text-xs transition-colors hover:bg-accent hover:text-foreground"
+          />
+        }
+      >
+        {icon}
+        {label}
+        <ChevronDownIcon className="size-3 opacity-60" />
+      </MenuTrigger>
+      <MenuPopup align="start" side="top">
+        <MenuRadioGroup value={value} onValueChange={(next) => onChange(String(next))}>
+          {options.map((option) => (
+            <MenuRadioItem key={option.value} value={option.value} closeOnClick>
+              {option.label}
+            </MenuRadioItem>
+          ))}
+        </MenuRadioGroup>
+      </MenuPopup>
+    </Menu>
+  );
+}
+
+const AssistantMessage = memo(function AssistantMessage({
+  text,
+  streaming,
+  cwd,
+  showRewrites,
+  onRewrite,
+}: {
+  text: string;
+  streaming: boolean;
+  cwd: string | undefined;
+  showRewrites: boolean;
+  onRewrite: (prompt: string) => void;
+}) {
+  const [copied, setCopied] = useState(false);
+  const copy = () => {
+    void navigator.clipboard.writeText(text).then(() => {
+      setCopied(true);
+      setTimeout(() => setCopied(false), 1500);
+    });
+  };
+  return (
+    <div className="group/msg min-w-0 text-sm">
+      <ChatMarkdown text={text} cwd={cwd} isStreaming={streaming} />
+      {streaming ? null : (
+        <div
+          className={cn(
+            "mt-1.5 flex flex-wrap items-center gap-1 transition-opacity",
+            !showRewrites && "opacity-0 group-hover/msg:opacity-100",
+          )}
+        >
+          <button
+            type="button"
+            onClick={copy}
+            className="flex h-6 cursor-pointer items-center gap-1 rounded-full bg-primary px-2 text-primary-foreground text-xs transition-colors hover:bg-primary/90"
+          >
+            {copied ? <CheckIcon className="size-3" /> : <CopyIcon className="size-3" />}
+            {copied ? "Copied" : "Copy"}
+          </button>
+          {showRewrites
+            ? REWRITES.map((rewrite) => (
+                <button
+                  key={rewrite.label}
+                  type="button"
+                  onClick={() => onRewrite(rewrite.prompt)}
+                  className="h-6 cursor-pointer rounded-full border border-border/70 px-2 text-muted-foreground text-xs transition-colors hover:bg-accent hover:text-foreground"
+                >
+                  {rewrite.label}
+                </button>
+              ))
+            : null}
+        </div>
+      )}
+    </div>
+  );
+});
+
+/** Small trigger for the composer status bar. */
+export function ChatPanelButton() {
+  const mode = useChatPanelStore((state) => state.mode);
+  const toggle = useChatPanelStore((state) => state.toggle);
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <button
+            type="button"
+            onClick={toggle}
+            className={cn(
+              "flex cursor-pointer items-center gap-1 rounded-full px-1.5 py-0.5 transition-colors hover:bg-accent hover:text-foreground",
+              mode === "open" && "text-primary",
+            )}
+          />
+        }
+      >
+        <SparklesIcon className="size-3" />
+        Chat
+      </TooltipTrigger>
+      <TooltipPopup side="top">Chat ({CHAT_PANEL_SHORTCUT_LABEL})</TooltipPopup>
+    </Tooltip>
+  );
+}
