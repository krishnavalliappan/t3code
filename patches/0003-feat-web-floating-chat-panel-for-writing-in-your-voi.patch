@@ -0,0 +1,106 @@
+import { scopeProjectRef } from "@t3tools/client-runtime/environment";
+import { findProjectByPath } from "@t3tools/client-runtime/state/projects";
+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import type { EnvironmentProject } from "@t3tools/client-runtime/state/shell";
+import type { EnvironmentId, ProjectId, ServerConfig } from "@t3tools/contracts";
+import { useCallback, useMemo, useRef } from "react";
+
+import { newProjectId } from "~/lib/utils";
+import { useProjects, useServerConfigs, waitForProject } from "~/state/entities";
+import { usePrimaryEnvironmentId } from "~/state/environments";
+import { projectEnvironment } from "~/state/projects";
+import { useAtomCommand } from "~/state/use-atom-command";
+
+/**
+ * The floating chat lives in `<home>/Chat`, a plain folder whose CLAUDE.md,
+ * voice.md and memory give Claude its long-term context. Home is read off the
+ * server's managed folders (`<home>/.t3/...`), since the web client has no
+ * other way to learn it.
+ */
+export function chatPanelRootFor(config: ServerConfig | undefined): string | null {
+  for (const managed of [config?.scratchWorkspaceRoot, config?.newProjectsRoot]) {
+    const home = managed ? /^(.*?)[\\/]\.t3(?:[\\/]|$)/.exec(managed)?.[1] : undefined;
+    if (home) return `${home}/Chat`;
+  }
+  return null;
+}
+
+export function isChatPanelProject(
+  project: Pick<EnvironmentProject, "workspaceRoot">,
+  config: ServerConfig | undefined,
+): boolean {
+  const root = chatPanelRootFor(config);
+  return root !== null && findProjectByPath([project], root) !== undefined;
+}
+
+/** Drops threads of the ~/Chat project; the floating panel lists those itself. */
+export function useWithoutChatPanelThreads<
+  T extends { readonly environmentId: EnvironmentId; readonly projectId: ProjectId },
+>(projects: ReadonlyArray<EnvironmentProject>, threads: ReadonlyArray<T>): ReadonlyArray<T> {
+  const serverConfigs = useServerConfigs();
+  return useMemo(() => {
+    const hidden = new Set(
+      projects
+        .filter((project) => isChatPanelProject(project, serverConfigs.get(project.environmentId)))
+        .map((project) => `${project.environmentId}:${project.id}`),
+    );
+    return hidden.size === 0
+      ? threads
+      : threads.filter((thread) => !hidden.has(`${thread.environmentId}:${thread.projectId}`));
+  }, [projects, serverConfigs, threads]);
+}
+
+export function useChatPanelProject() {
+  const environmentId = usePrimaryEnvironmentId();
+  const serverConfigs = useServerConfigs();
+  const projects = useProjects();
+  const createProject = useAtomCommand(projectEnvironment.create, { reportFailure: false });
+  const pending = useRef<Promise<EnvironmentProject> | null>(null);
+
+  const root = environmentId === null ? null : chatPanelRootFor(serverConfigs.get(environmentId));
+  const project = useMemo(
+    () =>
+      root === null
+        ? null
+        : (findProjectByPath(
+            projects.filter((candidate) => candidate.environmentId === environmentId),
+            root,
+          ) ?? null),
+    [environmentId, projects, root],
+  );
+
+  /** Returns the Chat project, adding `~/Chat` as a project the first time. */
+  const ensureProject = useCallback(async (): Promise<EnvironmentProject> => {
+    if (project) return project;
+    if (environmentId === null || root === null) {
+      throw new Error("Chat needs a connected local environment.");
+    }
+    pending.current ??= (async () => {
+      const projectId = newProjectId();
+      const result = await createProject({
+        environmentId,
+        input: {
+          projectId,
+          title: "Chat",
+          workspaceRoot: root,
+          createWorkspaceRootIfMissing: true,
+          defaultModelSelection: null,
+        },
+      });
+      if (result._tag === "Failure") {
+        throw isAtomCommandInterrupted(result)
+          ? new Error("Creating the Chat project was interrupted.")
+          : squashAtomCommandFailure(result);
+      }
+      return waitForProject(scopeProjectRef(environmentId, projectId));
+    })().finally(() => {
+      pending.current = null;
+    });
+    return pending.current;
+  }, [createProject, environmentId, project, root]);
+
+  return { environmentId, root, project, ensureProject };
+}
