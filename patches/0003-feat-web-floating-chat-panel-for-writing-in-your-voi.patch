@@ -0,0 +1,286 @@
+import { turnItemIsWorkspacePreparation } from "@t3tools/client-runtime/state/turn-item-presentation";
+import type { OrchestrationV2TurnItem } from "@t3tools/contracts";
+import {
+  BotIcon,
+  BrainIcon,
+  CheckIcon,
+  ChevronRightIcon,
+  FilePenIcon,
+  GlobeIcon,
+  PlugIcon,
+  SearchIcon,
+  TerminalIcon,
+  TriangleAlertIcon,
+  XIcon,
+} from "lucide-react";
+import { memo, useState } from "react";
+
+import { cn } from "~/lib/utils";
+import { Spinner } from "../ui/spinner";
+
+type StepStatus = "running" | "done" | "failed";
+type StepKind = "thinking" | "command" | "web" | "search" | "edit" | "tool" | "agent" | "error";
+
+export interface ActivityStep {
+  readonly id: string;
+  readonly kind: StepKind;
+  readonly label: string;
+  readonly detail: string | null;
+  readonly body: string | null;
+  readonly status: StepStatus;
+}
+
+const ICONS: Record<StepKind, typeof TerminalIcon> = {
+  thinking: BrainIcon,
+  command: TerminalIcon,
+  web: GlobeIcon,
+  search: SearchIcon,
+  edit: FilePenIcon,
+  tool: PlugIcon,
+  agent: BotIcon,
+  error: TriangleAlertIcon,
+};
+
+const BODY_LIMIT = 4000;
+const HIDDEN_TOOLS = new Set(["ToolSearch"]);
+
+function normalized(text: string): string {
+  return text.toLowerCase().replace(/[^a-z0-9]/g, "");
+}
+
+function clip(text: string | null | undefined, limit = BODY_LIMIT): string | null {
+  const trimmed = text?.trim();
+  if (!trimmed) return null;
+  return trimmed.length > limit ? `${trimmed.slice(0, limit)}\n…` : trimmed;
+}
+
+function firstLine(text: string | null | undefined): string | null {
+  return text?.trim().split("\n")[0]?.slice(0, 200) || null;
+}
+
+function stepStatus(item: OrchestrationV2TurnItem): StepStatus {
+  switch (item.status) {
+    case "failed":
+    case "cancelled":
+    case "interrupted":
+      return "failed";
+    case "pending":
+    case "running":
+    case "waiting":
+      return "running";
+    default:
+      return "done";
+  }
+}
+
+/** `mcp__claude_ai_Smartsheet__get_sheet` → `Smartsheet · get sheet`. */
+export function toolDisplayName(toolName: string | null): string {
+  if (!toolName) return "Tool";
+  const mcp = /^mcp__(.+?)__(.+)$/.exec(toolName);
+  if (!mcp) return toolName;
+  const server = (mcp[1] ?? "").replace(/^claude_ai_/, "").replace(/_/g, " ");
+  return `${server} · ${(mcp[2] ?? "").replace(/_/g, " ")}`;
+}
+
+/** The most telling string in a tool's input: a query, URL, path, or else the first string. */
+function inputSummary(input: unknown): string | null {
+  if (typeof input === "string") return firstLine(input);
+  if (input === null || typeof input !== "object") return null;
+  const record = input as Record<string, unknown>;
+  for (const key of ["query", "q", "url", "file_path", "path", "pattern", "command", "sheetName"]) {
+    if (typeof record[key] === "string") return firstLine(record[key] as string);
+  }
+  const first = Object.values(record).find((value) => typeof value === "string");
+  return typeof first === "string" ? firstLine(first) : null;
+}
+
+function outputText(output: unknown): string | null {
+  if (output === undefined || output === null) return null;
+  if (typeof output === "string") return clip(output);
+  if (Array.isArray(output)) {
+    const texts = output.flatMap((part) =>
+      part && typeof part === "object" && typeof (part as { text?: unknown }).text === "string"
+        ? [(part as { text: string }).text]
+        : [],
+    );
+    if (texts.length > 0) return clip(texts.join("\n"));
+  }
+  try {
+    return clip(JSON.stringify(output, null, 2));
+  } catch {
+    return null;
+  }
+}
+
+/** Maps a turn item to a compact activity row, or null for items the panel doesn't show. */
+export function toActivityStep(item: OrchestrationV2TurnItem): ActivityStep | null {
+  if (turnItemIsWorkspacePreparation(item)) return null;
+  // Claude loading deferred tool schemas, not something the user asked for.
+  if (item.type === "dynamic_tool" && HIDDEN_TOOLS.has(item.toolName ?? "")) return null;
+  const base = { id: item.id, status: stepStatus(item) };
+  switch (item.type) {
+    case "reasoning":
+      return item.text.trim()
+        ? {
+            ...base,
+            kind: "thinking",
+            label: "Thought",
+            detail: firstLine(item.text),
+            body: clip(item.text),
+          }
+        : null;
+    case "command_execution":
+      return {
+        ...base,
+        kind: "command",
+        label: "Ran",
+        detail: firstLine(item.input),
+        body: item.outputOmitted ? "(output not loaded)" : clip(item.output),
+        status:
+          item.outputIndicatesFailure || (item.exitCode !== undefined && item.exitCode !== 0)
+            ? "failed"
+            : base.status,
+      };
+    case "web_search":
+      return {
+        ...base,
+        kind: "web",
+        label: "Searched the web",
+        detail: item.patterns?.join(", ") || item.title,
+        body: clip(
+          item.results
+            ?.map((result) => [result.title, result.url].filter(Boolean).join(" — "))
+            .join("\n"),
+        ),
+      };
+    case "file_search":
+      return {
+        ...base,
+        kind: "search",
+        label: "Searched files",
+        detail: item.pattern ?? item.title,
+        body: clip(item.results?.map((result) => result.fileName).join("\n")),
+      };
+    case "file_change":
+      return {
+        ...base,
+        kind: "edit",
+        label: "Edited",
+        detail: item.fileName.split(/[\\/]/).pop() ?? item.fileName,
+        body: clip(item.diffStr ?? item.newStr),
+      };
+    case "dynamic_tool": {
+      const label = toolDisplayName(item.toolName);
+      return {
+        ...base,
+        kind: "tool",
+        label,
+        // The title often just restates the tool name ("List Workspaces").
+        detail:
+          inputSummary(item.input) ??
+          (item.title && !normalized(label).endsWith(normalized(item.title)) ? item.title : null),
+        body: item.outputOmitted ? "(output not loaded)" : outputText(item.output),
+      };
+    }
+    case "subagent":
+      return {
+        ...base,
+        kind: "agent",
+        label: "Subagent",
+        detail: firstLine(item.prompt),
+        body: clip(item.result ?? item.progress),
+      };
+    case "error":
+      return {
+        ...base,
+        kind: "error",
+        label: "Error",
+        detail: firstLine(item.failure.message),
+        body: clip(item.failure.message),
+        status: "failed",
+      };
+    default:
+      return null;
+  }
+}
+
+function StatusMark({ status }: { status: StepStatus }) {
+  if (status === "running") return <Spinner className="size-3" />;
+  if (status === "failed") return <XIcon className="size-3 text-destructive" />;
+  return <CheckIcon className="size-3 text-muted-foreground/70" />;
+}
+
+function summarize(steps: ReadonlyArray<ActivityStep>): string {
+  const tools = steps.filter((step) => step.kind !== "thinking");
+  if (tools.length === 0) return "Thought it through";
+  const labels = [...new Set(tools.map((step) => step.label))].slice(0, 3).join(", ");
+  return `${tools.length} step${tools.length === 1 ? "" : "s"} · ${labels}`;
+}
+
+const StepRow = memo(function StepRow({ step }: { step: ActivityStep }) {
+  const [open, setOpen] = useState(false);
+  const Icon = ICONS[step.kind];
+  const expandable = step.body !== null;
+  return (
+    <li>
+      <button
+        type="button"
+        disabled={!expandable}
+        onClick={() => setOpen((value) => !value)}
+        className={cn(
+          "flex w-full min-w-0 items-center gap-2 rounded-md px-1.5 py-1 text-left",
+          expandable && "cursor-pointer hover:bg-accent",
+        )}
+      >
+        <Icon className="size-3.5 shrink-0 text-muted-foreground" />
+        <span className="shrink-0 text-foreground/90">{step.label}</span>
+        {step.detail ? (
+          <span className="min-w-0 flex-1 truncate font-mono text-2xs text-muted-foreground">
+            {step.detail}
+          </span>
+        ) : (
+          <span className="flex-1" />
+        )}
+        <StatusMark status={step.status} />
+      </button>
+      {open && step.body ? (
+        <pre className="mx-1.5 mt-1 mb-1.5 max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-md bg-muted/50 p-2 font-mono text-2xs text-muted-foreground">
+          {step.body}
+        </pre>
+      ) : null}
+    </li>
+  );
+});
+
+/** A run of tool/thinking steps between messages. Open while live, folded once done. */
+export const ActivityGroup = memo(function ActivityGroup({
+  steps,
+  live,
+}: {
+  steps: ReadonlyArray<ActivityStep>;
+  live: boolean;
+}) {
+  const [userOpen, setUserOpen] = useState<boolean | null>(null);
+  const open = userOpen ?? live;
+  const running = live && steps.some((step) => step.status === "running");
+  return (
+    <div className="text-xs">
+      <button
+        type="button"
+        onClick={() => setUserOpen(!open)}
+        className="flex cursor-pointer items-center gap-1.5 rounded-md py-0.5 text-muted-foreground transition-colors hover:text-foreground"
+      >
+        <ChevronRightIcon className={cn("size-3 transition-transform", open && "rotate-90")} />
+        {running ? <Spinner className="size-3" /> : null}
+        <span>{running ? "Working…" : summarize(steps)}</span>
+      </button>
+      {open ? (
+        <ul className="mt-1 ml-1.5 border-border/60 border-l pl-2">
+          {steps.map((step) => (
+            <StepRow key={step.id} step={step} />
+          ))}
+        </ul>
+      ) : null}
+    </div>
+  );
+});
