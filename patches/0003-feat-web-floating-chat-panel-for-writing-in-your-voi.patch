@@ -0,0 +1,72 @@
+import type { ThreadId } from "@t3tools/contracts";
+import { create } from "zustand";
+import { createJSONStorage, persist } from "zustand/middleware";
+
+import { resolveStorage } from "~/lib/storage";
+
+export type ChatPanelMode = "closed" | "open" | "minimized";
+export type ChatPanelView = "chat" | "history";
+
+/** Tones map to `## <Tone>` sections in ~/Chat/voice.md. "Mine" is the default voice. */
+export const CHAT_PANEL_TONES = ["Mine", "Client", "Team", "Formal"] as const;
+export type ChatPanelTone = (typeof CHAT_PANEL_TONES)[number];
+
+interface ChatPanelState {
+  readonly mode: ChatPanelMode;
+  readonly view: ChatPanelView;
+  readonly activeThreadId: ThreadId | null;
+  readonly model: string | null;
+  readonly tone: ChatPanelTone;
+  readonly toggle: () => void;
+  readonly setMode: (mode: ChatPanelMode) => void;
+  readonly setView: (view: ChatPanelView) => void;
+  readonly selectThread: (threadId: ThreadId | null) => void;
+  readonly setModel: (model: string) => void;
+  readonly setTone: (tone: ChatPanelTone) => void;
+}
+
+export const useChatPanelStore = create<ChatPanelState>()(
+  persist(
+    (set) => ({
+      mode: "closed",
+      view: "chat",
+      activeThreadId: null,
+      model: null,
+      tone: "Mine",
+      toggle: () => set((state) => ({ mode: state.mode === "open" ? "closed" : "open" })),
+      setMode: (mode) => set({ mode }),
+      setView: (view) => set({ view }),
+      selectThread: (activeThreadId) => set({ activeThreadId, view: "chat", mode: "open" }),
+      setModel: (model) => set({ model }),
+      setTone: (tone) => set({ tone }),
+    }),
+    {
+      name: "t3code:chat-panel:v1",
+      storage: createJSONStorage(() =>
+        resolveStorage(typeof window !== "undefined" ? window.localStorage : undefined),
+      ),
+      version: 1,
+      partialize: ({ mode, activeThreadId, model, tone }) => ({
+        // Reopen minimized rather than covering the app on launch.
+        mode: mode === "open" ? "minimized" : mode,
+        activeThreadId,
+        model,
+        tone,
+      }),
+    },
+  ),
+);
+
+const TONE_PREFIX = /^Tone: (\w+)\n\n/;
+
+/** Prefixes the tone so Claude picks the matching section of voice.md. */
+export function withTone(text: string, tone: ChatPanelTone): string {
+  return tone === "Mine" ? text : `Tone: ${tone}\n\n${text}`;
+}
+
+export function stripTone(text: string): { readonly text: string; readonly tone: string | null } {
+  const match = TONE_PREFIX.exec(text);
+  return match
+    ? { text: text.slice(match[0].length), tone: match[1] ?? null }
+    : { text, tone: null };
+}
