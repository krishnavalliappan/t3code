+import { memo, type PointerEvent, type RefObject, useCallback, useEffect, useRef } from "react";
+
+import { useChatPanelStore, type ChatPanelSize } from "./chatPanelStore";
+
+type Edge = "left" | "top" | "corner";
+
+/** Resize imperatively during the drag; persist only when it ends. */
+export const ChatPanelResize = memo(function ChatPanelResize({
+  panelRef,
+}: {
+  panelRef: RefObject<HTMLDivElement | null>;
+}) {
+  const setSize = useChatPanelStore((state) => state.setSize);
+  const dragRef = useRef<{
+    pointerId: number;
+    edge: Edge;
+    x: number;
+    y: number;
+    start: ChatPanelSize;
+    size: ChatPanelSize;
+    userSelect: string;
+    cursor: string;
+  } | null>(null);
+
+  const finish = useCallback(() => {
+    const drag = dragRef.current;
+    if (!drag) return;
+    dragRef.current = null;
+    document.body.style.userSelect = drag.userSelect;
+    document.body.style.cursor = drag.cursor;
+    // A plain click shouldn't pin the default size.
+    if (drag.size.width !== drag.start.width || drag.size.height !== drag.start.height) {
+      setSize(drag.size);
+    }
+  }, [setSize]);
+
+  useEffect(() => finish, [finish]);
+
+  const start = useCallback(
+    (event: PointerEvent<HTMLButtonElement>, edge: Edge) => {
+      const panel = panelRef.current;
+      if (!panel || event.button !== 0 || dragRef.current) return;
+      event.preventDefault();
+      event.currentTarget.setPointerCapture(event.pointerId);
+      const { width, height } = panel.getBoundingClientRect();
+      dragRef.current = {
+        pointerId: event.pointerId,
+        edge,
+        x: event.clientX,
+        y: event.clientY,
+        start: { width, height },
+        size: { width, height },
+        userSelect: document.body.style.userSelect,
+        cursor: document.body.style.cursor,
+      };
+      document.body.style.userSelect = "none";
+      document.body.style.cursor = getComputedStyle(event.currentTarget).cursor;
+    },
+    [panelRef],
+  );
+
+  const move = useCallback(
+    (event: PointerEvent<HTMLButtonElement>) => {
+      const drag = dragRef.current;
+      const panel = panelRef.current;
+      if (!drag || drag.pointerId !== event.pointerId || !panel) return;
+      const width = drag.start.width + (drag.edge === "top" ? 0 : drag.x - event.clientX);
+      const height = drag.start.height + (drag.edge === "left" ? 0 : drag.y - event.clientY);
+      drag.size = {
+        width: Math.min(window.innerWidth - 32, Math.max(340, width)),
+        height: Math.min(window.innerHeight - 32, Math.max(360, height)),
+      };
+      // React won't rewrite an unchanged axis on release, so keep viewport caps here too.
+      panel.style.width = `min(${drag.size.width}px, calc(100vw - 2rem))`;
+      panel.style.height = `min(${drag.size.height}px, calc(100dvh - 2rem))`;
+    },
+    [panelRef],
+  );
+
+  const reset = useCallback(() => {
+    setSize(null);
+    panelRef.current?.style.removeProperty("width");
+    panelRef.current?.style.removeProperty("height");
+  }, [panelRef, setSize]);
+
+  return (
+    <>
+      {(["left", "top", "corner"] as const).map((edge) => (
+        <button
+          key={edge}
+          type="button"
+          tabIndex={-1}
+          aria-label={`Resize chat from ${edge}`}
+          onPointerDown={(event) => start(event, edge)}
+          onPointerMove={move}
+          onPointerUp={finish}
+          onPointerCancel={finish}
+          onLostPointerCapture={finish}
+          onDoubleClick={reset}
+          className={
+            edge === "corner"
+              ? "absolute top-0 left-0 z-20 size-3 touch-none cursor-nwse-resize"
+              : edge === "left"
+                ? "absolute inset-y-0 left-0 z-10 w-1.5 touch-none cursor-ew-resize"
+                : "absolute inset-x-0 top-0 z-10 h-1.5 touch-none cursor-ns-resize"
+          }
+        />
+      ))}
+    </>
+  );
+});
diff --git a/apps/web/src/components/chatPanel/chatPanelStore.ts b/apps/web/src/components/chatPanel/chatPanelStore.ts
new file mode 100644
index 000000000..17fea1f92
--- /dev/null
+++ b/apps/web/src/components/chatPanel/chatPanelStore.ts
@@ -0,0 +1,95 @@
+import type { ThreadId } from "@t3tools/contracts";
+import { create } from "zustand";
+import { createJSONStorage, persist } from "zustand/middleware";
+
+import { resolveStorage } from "~/lib/storage";
+
+export type ChatPanelMode = "closed" | "open" | "minimized";
+export type ChatPanelView = "chat" | "history";
+export interface ChatPanelSize {
+  readonly width: number;
+  readonly height: number;
+}
+
+/** Tones map to `## <Tone>` sections in ~/Chat/voice.md. "Mine" is the default voice. */
+export const CHAT_PANEL_TONES = ["Mine", "Client", "Team", "Formal"] as const;
+export type ChatPanelTone = (typeof CHAT_PANEL_TONES)[number];
+
+/** Claude's reasoning effort. Low keeps drafting snappy; the provider default (high) thinks for seconds per step. */
+export const CHAT_PANEL_EFFORTS = [
+  { value: "low", label: "Fast" },
+  { value: "medium", label: "Balanced" },
+  { value: "high", label: "Deep" },
+] as const;
+export type ChatPanelEffort = (typeof CHAT_PANEL_EFFORTS)[number]["value"];
+
+interface ChatPanelState {
+  readonly mode: ChatPanelMode;
+  readonly view: ChatPanelView;
+  readonly activeThreadId: ThreadId | null;
+  readonly model: string | null;
+  readonly tone: ChatPanelTone;
+  readonly effort: ChatPanelEffort;
+  /** User-dragged size; null keeps the default. */
+  readonly size: ChatPanelSize | null;
+  readonly toggle: () => void;
+  readonly setMode: (mode: ChatPanelMode) => void;
+  readonly setView: (view: ChatPanelView) => void;
+  readonly selectThread: (threadId: ThreadId | null) => void;
+  readonly setModel: (model: string) => void;
+  readonly setTone: (tone: ChatPanelTone) => void;
+  readonly setEffort: (effort: ChatPanelEffort) => void;
+  readonly setSize: (size: ChatPanelSize | null) => void;
+}
+
+export const useChatPanelStore = create<ChatPanelState>()(
+  persist(
+    (set) => ({
+      mode: "closed",
+      view: "chat",
+      activeThreadId: null,
+      model: null,
+      tone: "Mine",
+      effort: "low",
+      size: null,
+      toggle: () => set((state) => ({ mode: state.mode === "open" ? "closed" : "open" })),
+      setMode: (mode) => set({ mode }),
+      setView: (view) => set({ view }),
+      selectThread: (activeThreadId) => set({ activeThreadId, view: "chat", mode: "open" }),
+      setModel: (model) => set({ model }),
+      setTone: (tone) => set({ tone }),
+      setEffort: (effort) => set({ effort }),
+      setSize: (size) => set({ size }),
+    }),
+    {
+      name: "t3code:chat-panel:v1",
+      storage: createJSONStorage(() =>
+        resolveStorage(typeof window !== "undefined" ? window.localStorage : undefined),
+      ),
+      version: 1,
+      partialize: ({ mode, activeThreadId, model, tone, effort, size }) => ({
+        // Reopen minimized rather than covering the app on launch.
+        mode: mode === "open" ? "minimized" : mode,
+        activeThreadId,
+        model,
+        tone,
+        effort,
+        size,
+      }),
+    },
+  ),
+);
+
+const TONE_PREFIX = /^Tone: (\w+)\n\n/;
+
+/** Prefixes the tone so Claude picks the matching section of voice.md. */
+export function withTone(text: string, tone: ChatPanelTone): string {
+  return tone === "Mine" ? text : `Tone: ${tone}\n\n${text}`;
+}
+
+export function stripTone(text: string): { readonly text: string; readonly tone: string | null } {
+  const match = TONE_PREFIX.exec(text);
+  return match
+    ? { text: text.slice(match[0].length), tone: match[1] ?? null }
+    : { text, tone: null };
+}
diff --git a/apps/web/src/components/chatPanel/useChatPanelProject.ts b/apps/web/src/components/chatPanel/useChatPanelProject.ts
new file mode 100644
index 000000000..3e455461b
--- /dev/null
+++ b/apps/web/src/components/chatPanel/useChatPanelProject.ts
@@ -0,0 +1,108 @@
+import { scopeProjectRef } from "@t3tools/client-runtime/environment";
+import { findProjectByPath } from "@t3tools/client-runtime/state/projects";
+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import type { EnvironmentProject } from "@t3tools/client-runtime/state/shell";
+import type { EnvironmentId, ProjectId, ServerConfig } from "@t3tools/contracts";
+import { useCallback, useMemo, useRef } from "react";
+
+import { newProjectId } from "~/lib/utils";
+import { useProjects, useServerConfigs, waitForProject } from "~/state/entities";
+import { usePrimaryEnvironmentId } from "~/state/environments";
+import { projectEnvironment } from "~/state/projects";
+import { useAtomCommand } from "~/state/use-atom-command";
+
+type ChatPanelRootConfig = Pick<ServerConfig, "scratchWorkspaceRoot" | "newProjectsRoot">;
+
+/**
+ * The floating chat lives in `<home>/Chat`, a plain folder whose CLAUDE.md,
+ * voice.md and memory give Claude its long-term context. Home is read off the
+ * server's managed folders (`<home>/.t3/...`), since the web client has no
+ * other way to learn it.
+ */
+export function chatPanelRootFor(config: ChatPanelRootConfig | undefined): string | null {
+  for (const managed of [config?.scratchWorkspaceRoot, config?.newProjectsRoot]) {
+    const home = managed ? /^(.*?)[\\/]\.t3(?:[\\/]|$)/.exec(managed)?.[1] : undefined;
+    if (home) return `${home}/Chat`;
+  }
+  return null;
+}
+
+export function isChatPanelProject(
+  project: Pick<EnvironmentProject, "workspaceRoot">,
+  config: ChatPanelRootConfig | undefined,
+): boolean {
+  const root = chatPanelRootFor(config);
+  return root !== null && findProjectByPath([project], root) !== undefined;
+}
+
+/** Drops threads of the ~/Chat project; the floating panel lists those itself. */
+export function useWithoutChatPanelThreads<
+  T extends { readonly environmentId: EnvironmentId; readonly projectId: ProjectId },
+>(projects: ReadonlyArray<EnvironmentProject>, threads: ReadonlyArray<T>): ReadonlyArray<T> {
+  const serverConfigs = useServerConfigs();
+  return useMemo(() => {
+    const hidden = new Set(
+      projects
+        .filter((project) => isChatPanelProject(project, serverConfigs.get(project.environmentId)))
+        .map((project) => `${project.environmentId}:${project.id}`),
+    );
+    return hidden.size === 0
+      ? threads
+      : threads.filter((thread) => !hidden.has(`${thread.environmentId}:${thread.projectId}`));
+  }, [projects, serverConfigs, threads]);
+}
+
+export function useChatPanelProject() {
+  const environmentId = usePrimaryEnvironmentId();
+  const serverConfigs = useServerConfigs();
+  const projects = useProjects();
+  const createProject = useAtomCommand(projectEnvironment.create, { reportFailure: false });
+  const pending = useRef<Promise<EnvironmentProject> | null>(null);
+
+  const root = environmentId === null ? null : chatPanelRootFor(serverConfigs.get(environmentId));
+  const project = useMemo(
+    () =>
+      root === null
+        ? null
+        : (findProjectByPath(
+            projects.filter((candidate) => candidate.environmentId === environmentId),
+            root,
+          ) ?? null),
+    [environmentId, projects, root],
+  );
+
+  /** Returns the Chat project, adding `~/Chat` as a project the first time. */
+  const ensureProject = useCallback(async (): Promise<EnvironmentProject> => {
+    if (project) return project;
+    if (environmentId === null || root === null) {
+      throw new Error("Chat needs a connected local environment.");
+    }
+    pending.current ??= (async () => {
+      const projectId = newProjectId();
+      const result = await createProject({
+        environmentId,
+        input: {
+          projectId,
+          title: "Chat",
+          workspaceRoot: root,
+          createWorkspaceRootIfMissing: true,
+          defaultModelSelection: null,
+        },
+      });
+      if (result._tag === "Failure") {
+        throw isAtomCommandInterrupted(result)
+          ? new Error("Creating the Chat project was interrupted.")
+          : squashAtomCommandFailure(result);
+      }
+      return waitForProject(scopeProjectRef(environmentId, projectId));
+    })().finally(() => {
+      pending.current = null;
+    });
+    return pending.current;
+  }, [createProject, environmentId, project, root]);
+
+  return { environmentId, root, project, ensureProject };
+}
