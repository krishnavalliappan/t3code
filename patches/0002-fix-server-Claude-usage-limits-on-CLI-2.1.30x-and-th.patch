+/**
+ * Newer CLIs (2.1.30x) send every account-wide window on each event under
+ * `unifiedWindows`, with no top-level `utilization`. Not in the SDK typings
+ * we pin, so it is read structurally.
+ */
+function readUnifiedWindows(info: SDKRateLimitInfo): ReadonlyArray<ServerProviderUsageWindow> {
+  const raw = (info as { readonly unifiedWindows?: unknown }).unifiedWindows;
+  if (typeof raw !== "object" || raw === null) return [];
+  const windows: ServerProviderUsageWindow[] = [];
+  for (const id of Object.keys(WINDOWS)) {
+    const entry = (raw as Record<string, { utilization?: unknown; resetsAt?: unknown } | null>)[id];
+    if (!entry || typeof entry.utilization !== "number") continue;
+    const resetsAt = typeof entry.resetsAt === "number" ? entry.resetsAt : undefined;
+    windows.push(makeWindow(id, entry.utilization * 100, isoFromEpochSeconds(resetsAt)));
+  }
+  return windows;
+}
