diff --git a/apps/web/src/components/dictation/DictationButton.tsx b/apps/web/src/components/dictation/DictationButton.tsx
new file mode 100644
index 00000000..b465f513
--- /dev/null
+++ b/apps/web/src/components/dictation/DictationButton.tsx
@@ -0,0 +1,90 @@
+import { LoaderCircleIcon, MicIcon } from "lucide-react";
+import { useEffect } from "react";
+
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+import { toastManager } from "../ui/toast";
+import { cn, isMacPlatform } from "~/lib/utils";
+import { useDictation } from "./useDictation";
+
+/** ⌥⌘V on macOS (⇧⌘V is paste-as-text, ⌥⌘D toggles the Dock). */
+export const DICTATION_SHORTCUT_LABEL =
+  typeof navigator !== "undefined" && isMacPlatform(navigator.platform) ? "⌥⌘V" : "Ctrl+Alt+V";
+
+function isDictationShortcut(event: KeyboardEvent): boolean {
+  // `code`, not `key`: holding ⌥ turns "v" into "√" on macOS.
+  return (
+    (event.metaKey || event.ctrlKey) && event.altKey && !event.shiftKey && event.code === "KeyV"
+  );
+}
+
+/** Speak into the composer: click or ⌥⌘V to start, again to stop, Esc to cancel. */
+export function DictationButton({ onText }: { onText: (text: string) => void }) {
+  const { status, loadedBytes, toggle, cancel } = useDictation({
+    onText,
+    onError: (message) =>
+      toastManager.add({ type: "error", title: "Dictation failed", description: message }),
+  });
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (isDictationShortcut(event)) {
+        event.preventDefault();
+        event.stopPropagation();
+        toggle();
+      } else if (event.key === "Escape" && (status === "starting" || status === "recording")) {
+        event.preventDefault();
+        event.stopPropagation();
+        cancel();
+      }
+    };
+    window.addEventListener("keydown", onKeyDown, { capture: true });
+    return () => window.removeEventListener("keydown", onKeyDown, { capture: true });
+  }, [toggle, cancel, status]);
+
+  const label =
+    status === "starting"
+      ? "Starting mic"
+      : status === "recording"
+        ? "Listening"
+        : status === "transcribing"
+          ? loadedBytes !== null
+            ? `Downloading model ${Math.round(loadedBytes / 1_000_000)} MB`
+            : "Transcribing"
+          : "Dictate";
+  const hint =
+    status === "starting" || status === "recording"
+      ? `Stop and transcribe (${DICTATION_SHORTCUT_LABEL}) · Esc to cancel`
+      : `Dictate into the composer (${DICTATION_SHORTCUT_LABEL}) · on-device Whisper`;
+
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <button
+            type="button"
+            onClick={toggle}
+            disabled={status === "transcribing"}
+            aria-pressed={status === "starting" || status === "recording"}
+            className={cn(
+              "flex cursor-pointer items-center gap-1 rounded-full px-1.5 py-0.5 transition-colors hover:bg-accent hover:text-foreground disabled:cursor-default disabled:hover:bg-transparent",
+              (status === "starting" || status === "recording") && "text-(--color-error)",
+            )}
+          />
+        }
+      >
+        {status === "transcribing" ? (
+          <LoaderCircleIcon className="size-3 animate-spin" />
+        ) : (
+          <span className="relative flex">
+            <MicIcon className="size-3" />
+            {status === "recording" ? (
+              <span className="absolute -top-0.5 -right-0.5 size-1.5 animate-pulse rounded-full bg-(--color-error)" />
+            ) : null}
+          </span>
+        )}
+        <span className="tabular-nums">{label}</span>
+      </TooltipTrigger>
+      <TooltipPopup side="top">{hint}</TooltipPopup>
+    </Tooltip>
+  );
+}
diff --git a/apps/web/src/components/dictation/dictationProtocol.ts b/apps/web/src/components/dictation/dictationProtocol.ts
new file mode 100644
index 00000000..696a3958
--- /dev/null
+++ b/apps/web/src/components/dictation/dictationProtocol.ts
@@ -0,0 +1,13 @@
+/** Messages between the dictation hook and its Whisper worker. */
+export type DictationWorkerRequest =
+  | { readonly type: "warmup" }
+  | { readonly type: "transcribe"; readonly id: number; readonly audio: Float32Array };
+
+export type DictationWorkerResponse =
+  | { readonly type: "loading"; readonly loadedBytes: number }
+  | { readonly type: "ready" }
+  | { readonly type: "result"; readonly id: number; readonly text: string }
+  | { readonly type: "error"; readonly id: number | null; readonly message: string };
+
+/** Whisper expects 16 kHz mono PCM. */
+export const WHISPER_SAMPLE_RATE = 16_000;
diff --git a/apps/web/src/components/dictation/dictationWorker.ts b/apps/web/src/components/dictation/dictationWorker.ts
new file mode 100644
index 00000000..8cf15c48
--- /dev/null
+++ b/apps/web/src/components/dictation/dictationWorker.ts
@@ -0,0 +1,89 @@
+/// <reference lib="webworker" />
+/**
+ * Whisper speech-to-text, entirely on device. The model downloads from Hugging Face once and is
+ * then served from Cache Storage; the ONNX runtime is bundled with the app (no CDN code).
+ */
+import {
+  env,
+  pipeline,
+  type AutomaticSpeechRecognitionOutput,
+  type AutomaticSpeechRecognitionPipeline,
+} from "@huggingface/transformers";
+import ortWasmMjsUrl from "onnxruntime-web/ort-wasm-simd-threaded.asyncify.mjs?url";
+import ortWasmUrl from "onnxruntime-web/ort-wasm-simd-threaded.asyncify.wasm?url";
+
+import type { DictationWorkerRequest, DictationWorkerResponse } from "./dictationProtocol";
+
+const MODEL_ID = "onnx-community/whisper-base.en";
+
+env.allowLocalModels = false;
+// Import the bundled runtime by its own URL. The cache path re-wraps it as a blob: URL, which the
+// desktop app's CSP (script-src 'self') refuses: "no available backend found".
+env.useWasmCache = false;
+if (env.backends.onnx.wasm) {
+  env.backends.onnx.wasm.wasmPaths = { mjs: ortWasmMjsUrl, wasm: ortWasmUrl };
+}
+
+const scope = self as unknown as DedicatedWorkerGlobalScope;
+// oxlint-disable-next-line unicorn/require-post-message-target-origin -- A worker posts to its owner; there is no target origin.
+const post = (message: DictationWorkerResponse) => scope.postMessage(message);
+
+let transcriber: Promise<AutomaticSpeechRecognitionPipeline> | null = null;
+
+async function hasWebGpu(): Promise<boolean> {
+  const gpu = (navigator as Navigator & { gpu?: { requestAdapter(): Promise<unknown> } }).gpu;
+  try {
+    return (await gpu?.requestAdapter()) != null;
+  } catch {
+    return false;
+  }
+}
+
+function loadTranscriber(): Promise<AutomaticSpeechRecognitionPipeline> {
+  transcriber ??= (async () => {
+    const webgpu = await hasWebGpu();
+    // Bytes downloaded across all model files. Files are discovered one after another, so a
+    // percentage would jump back; a growing byte count doesn't.
+    const loadedByFile = new Map<string, number>();
+    const asr = await pipeline("automatic-speech-recognition", MODEL_ID, {
+      device: webgpu ? "webgpu" : "wasm",
+      dtype: webgpu ? { encoder_model: "fp32", decoder_model_merged: "q4" } : "q8",
+      progress_callback: (info) => {
+        if (info.status !== "progress") return;
+        loadedByFile.set(info.file, info.loaded);
+        let loadedBytes = 0;
+        for (const loaded of loadedByFile.values()) loadedBytes += loaded;
+        post({ type: "loading", loadedBytes });
+      },
+    });
+    return asr as AutomaticSpeechRecognitionPipeline;
+  })();
+  transcriber.catch(() => {
+    transcriber = null; // let the next attempt retry, e.g. after a network blip
+  });
+  return transcriber;
+}
+
+scope.addEventListener("message", (event: MessageEvent<DictationWorkerRequest>) => {
+  const request = event.data;
+  void (async () => {
+    try {
+      const asr = await loadTranscriber();
+      if (request.type === "warmup") {
+        post({ type: "ready" });
+        return;
+      }
+      const output = (await asr(request.audio, {
+        chunk_length_s: 30,
+        stride_length_s: 5,
+      })) as AutomaticSpeechRecognitionOutput;
+      post({ type: "result", id: request.id, text: output.text });
+    } catch (error) {
+      post({
+        type: "error",
+        id: request.type === "transcribe" ? request.id : null,
+        message: error instanceof Error ? error.message : String(error),
+      });
+    }
+  })();
+});
diff --git a/apps/web/src/components/dictation/useDictation.ts b/apps/web/src/components/dictation/useDictation.ts
new file mode 100644
index 00000000..972fc543
--- /dev/null
+++ b/apps/web/src/components/dictation/useDictation.ts
@@ -0,0 +1,179 @@
+import { useEffect, useRef, useState } from "react";
+
+import { useStableCallback } from "~/hooks/useStableCallback";
+
+import {
+  WHISPER_SAMPLE_RATE,
+  type DictationWorkerRequest,
+  type DictationWorkerResponse,
+} from "./dictationProtocol";
+import DictationWorker from "./dictationWorker?worker";
+
+/** "starting" covers the wait for the mic to open, which can take a second. */
+export type DictationStatus = "idle" | "starting" | "recording" | "transcribing";
+
+/** One Whisper worker for the whole app, so the model loads once per session. */
+let sharedWorker: Worker | null = null;
+let nextRequestId = 1;
+function getWorker(): Worker {
+  sharedWorker ??= new DictationWorker();
+  return sharedWorker;
+}
+
+function post(request: DictationWorkerRequest, transfer: Transferable[] = []) {
+  getWorker().postMessage(request, transfer);
+}
+
+/** Decodes a recording (webm/opus) to the 16 kHz mono PCM Whisper expects. */
+async function decodeToPcm(blob: Blob): Promise<Float32Array> {
+  const context = new AudioContext({ sampleRate: WHISPER_SAMPLE_RATE });
+  try {
+    const buffer = await context.decodeAudioData(await blob.arrayBuffer());
+    return new Float32Array(buffer.getChannelData(0)); // own copy, so it can be transferred
+  } finally {
+    void context.close();
+  }
+}
+
+/**
+ * Whisper marks silence and noise with bracketed tags ("[BLANK_AUDIO]", "(wind blowing)") and
+ * pads with a leading space. Returns "" when nothing was actually said.
+ */
+export function cleanTranscript(text: string): string {
+  return text
+    .replace(/\[[^\]]*\]|\([^)]*\)/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+export function useDictation(options: {
+  onText: (text: string) => void;
+  onError: (message: string) => void;
+}) {
+  const [status, setStatus] = useState<DictationStatus>("idle");
+  /** Bytes of the model downloaded so far while the first transcription waits on it; null otherwise. */
+  const [loadedBytes, setLoadedBytes] = useState<number | null>(null);
+  const recorderRef = useRef<MediaRecorder | null>(null);
+  const startingRef = useRef(false);
+  const cancelStartRef = useRef(false);
+  const discardRef = useRef(false);
+  const pendingIdRef = useRef<number | null>(null);
+  const unmountedRef = useRef(false);
+  const onText = useStableCallback(options.onText);
+  const onError = useStableCallback(options.onError);
+
+  useEffect(() => {
+    unmountedRef.current = false;
+    const worker = getWorker();
+    const onMessage = (event: MessageEvent<DictationWorkerResponse>) => {
+      const message = event.data;
+      if (message.type === "loading") {
+        setLoadedBytes(message.loadedBytes);
+        return;
+      }
+      if (message.type === "ready") {
+        setLoadedBytes(null);
+        return;
+      }
+      if (message.id !== pendingIdRef.current) return;
+      pendingIdRef.current = null;
+      setLoadedBytes(null);
+      setStatus("idle");
+      if (message.type === "error") {
+        onError(message.message);
+        return;
+      }
+      const text = cleanTranscript(message.text);
+      if (text !== "") onText(text);
+    };
+    worker.addEventListener("message", onMessage);
+    return () => {
+      worker.removeEventListener("message", onMessage);
+      unmountedRef.current = true;
+      // Leaving the thread mid-recording drops the take rather than typing into another thread.
+      discardRef.current = true;
+      recorderRef.current?.stop();
+    };
+  }, [onText, onError]);
+
+  const start = async () => {
+    if (startingRef.current || recorderRef.current !== null || pendingIdRef.current !== null)
+      return;
+    startingRef.current = true;
+    cancelStartRef.current = false;
+    setStatus("starting");
+    let stream: MediaStream;
+    try {
+      stream = await navigator.mediaDevices.getUserMedia({
+        audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true },
+      });
+    } catch (error) {
+      startingRef.current = false;
+      setStatus("idle");
+      if (cancelStartRef.current) return;
+      onError(
+        error instanceof DOMException && error.name === "NotAllowedError"
+          ? "Microphone access is blocked. Allow T3 Code in System Settings → Privacy & Security → Microphone."
+          : `Couldn't open the microphone: ${error instanceof Error ? error.message : String(error)}`,
+      );
+      return;
+    }
+    startingRef.current = false;
+    if (unmountedRef.current || cancelStartRef.current) {
+      for (const track of stream.getTracks()) track.stop();
+      if (!unmountedRef.current) setStatus("idle");
+      return;
+    }
+    // Start loading the model while the user talks, so it's usually ready by the time they stop.
+    post({ type: "warmup" });
+    const chunks: Blob[] = [];
+    const recorder = new MediaRecorder(stream);
+    recorder.addEventListener("dataavailable", (event) => chunks.push(event.data));
+    recorder.addEventListener("stop", () => {
+      for (const track of stream.getTracks()) track.stop();
+      recorderRef.current = null;
+      if (discardRef.current) {
+        discardRef.current = false;
+        setStatus("idle");
+        return;
+      }
+      setStatus("transcribing");
+      void decodeToPcm(new Blob(chunks, { type: recorder.mimeType }))
+        .then((audio) => {
+          const id = nextRequestId++;
+          pendingIdRef.current = id;
+          post({ type: "transcribe", id, audio }, [audio.buffer]);
+        })
+        .catch((error: unknown) => {
+          setStatus("idle");
+          onError(
+            `Couldn't read the recording: ${error instanceof Error ? error.message : String(error)}`,
+          );
+        });
+    });
+    recorderRef.current = recorder;
+    discardRef.current = false;
+    recorder.start();
+    setStatus("recording");
+  };
+
+  const stop = () => recorderRef.current?.stop();
+
+  const cancel = () => {
+    if (startingRef.current) {
+      cancelStartRef.current = true;
+      setStatus("idle");
+      return;
+    }
+    discardRef.current = true;
+    recorderRef.current?.stop();
+  };
+
+  const toggle = () => {
+    if (startingRef.current) cancel();
+    else if (recorderRef.current !== null) stop();
+    else void start();
+  };
+
+  return { status, loadedBytes, start, stop, cancel, toggle };
+}
